# The repository remains in home; the large source dataset is staged in scratch.
ELFNET_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd -P)"
ELFNET_SOURCE_ROOT="${ELFNET_SOURCE_ROOT:-$RCAC_SCRATCH/dft-reference-elfs-50000-v1}"
ELFNET_RUN_ID="${ELFNET_RUN_ID:-elfnet-gnn-2026-10-24}"
ELFNET_RUN_ROOT="${ELFNET_RUN_ROOT:-${RCAC_SCRATCH:?RCAC_SCRATCH is not set}/electride-ml-predictor/$ELFNET_RUN_ID}"
ELFNET_FINAL_OUTPUT="${ELFNET_FINAL_OUTPUT:-$ELFNET_RUN_ROOT/dataset}"
ELFNET_CONDA_PREFIX="${ELFNET_CONDA_PREFIX:-$HOME/.conda/envs/elfnet-gnn}"
ELFNET_SAMPLES_PER_TASK="${ELFNET_SAMPLES_PER_TASK:-250}"
ELFNET_ARRAY_CONCURRENCY="${ELFNET_ARRAY_CONCURRENCY:-32}"
ELFNET_NO_HASHES="${ELFNET_NO_HASHES:-0}"

# Keep allocation-specific values out of Git. Set this in the shell or in the
# ignored `negishi.local.env` file before sourcing this environment.
LOCAL_ENV="$(dirname "${BASH_SOURCE[0]}")/negishi.local.env"
if [[ -f "$LOCAL_ENV" ]]; then
  # shellcheck source=/dev/null
  source "$LOCAL_ENV"
fi
ELFNET_SLURM_ACCOUNT="${ELFNET_SLURM_ACCOUNT:?Set ELFNET_SLURM_ACCOUNT before submitting}"
ELFNET_SLURM_QOS="${ELFNET_SLURM_QOS:-normal}"
ELFNET_SLURM_PARTITION="${ELFNET_SLURM_PARTITION:-cpu}"

export ELFNET_REPO ELFNET_SOURCE_ROOT ELFNET_RUN_ID ELFNET_RUN_ROOT
export ELFNET_FINAL_OUTPUT ELFNET_CONDA_PREFIX ELFNET_SAMPLES_PER_TASK
export ELFNET_ARRAY_CONCURRENCY ELFNET_NO_HASHES ELFNET_SLURM_ACCOUNT ELFNET_SLURM_QOS ELFNET_SLURM_PARTITION
