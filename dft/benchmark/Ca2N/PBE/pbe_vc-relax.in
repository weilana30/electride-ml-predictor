&CONTROL
  calculation = 'vc-relax',
  prefix = 'eld-0049_pbe',
  outdir = './out',
  pseudo_dir = '../../pseudo/PBE',
  tstress = .true.,
  tprnfor = .true.,
  nstep = 300,
  etot_conv_thr = 1.0d-5,
  forc_conv_thr = 1.0d-4,
  disk_io = 'low',
/
&SYSTEM
  ibrav = 0,
  nat = 3,
  ntyp = 2,
  ecutwfc = 100,
  ecutrho = 400,
  input_dft = 'pbe',
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.02,
/
&ELECTRONS
  conv_thr = 1.0d-9,
  mixing_mode = 'local-TF',
  mixing_beta = 0.40,
  electron_maxstep = 200,
  diagonalization = 'david',
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
  press = 0.0,
  press_conv_thr = 0.5,
  cell_dofree = 'all',
/

ATOMIC_SPECIES
  Ca   40.078000 Ca.upf
  N    14.007000 N.upf

CELL_PARAMETERS angstrom
      6.7548549000     0.0000000000     0.0000000000
      5.7938761013     3.4726163102     0.0000000000
      5.7938768602     1.6033422366     3.0803178354

ATOMIC_POSITIONS crystal
  Ca      0.73140824     0.73140824     0.73140824
  Ca      0.26859176     0.26859176     0.26859176
  N      -0.00000000    -0.00000000     0.00000000

K_POINTS automatic
  14 14 14 0 0 0

! Source: data/cifs/mp-2686.cif (mp-2686)
! 2D; canonical layered electride; light-element contrast
! PBE ONCV scalar-relativistic pseudopotentials
! Pre-production settings: converge cutoffs and k mesh before comparing functionals.
