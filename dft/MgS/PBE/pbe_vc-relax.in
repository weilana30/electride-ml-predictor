&CONTROL
  calculation = 'vc-relax',
  prefix = 'mp-1315_pbe',
  outdir = './out',
  pseudo_dir = '../../pseudo/PBE_PAW',
  tstress = .true.,
  tprnfor = .true.,
  nstep = 300,
  etot_conv_thr = 1.0d-5,
  forc_conv_thr = 1.0d-4,
  disk_io = 'low',
/
&SYSTEM
  ibrav = 0,
  nat = 2,
  ntyp = 2,
  
  
  input_dft = 'pbe',
  
  
  
  
  
  
  
  
  ecutwfc = 60,
  ecutrho = 480,
  occupations = 'smearing',
  smearing = 'methfessel-paxton',
  degauss = 0.02,
/
&ELECTRONS
  
  mixing_mode = 'local-TF',
  
  electron_maxstep = 200,
  diagonalization = 'david',
  
  
  conv_thr = 1.0d-8,
  mixing_beta = 0.7,
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dynamics = 'bfgs',
  press = 0.0,
  press_conv_thr = 0.5,
  cell_dofree = 'all',
/

ATOMIC_SPECIES
  Mg   24.305000 Mg.pbe-spnl-kjpaw_psl.1.0.0.UPF
  S    32.060000 S.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
      3.6831746100     0.0000000000     0.0000000000
      1.8415874463     3.1897227665     0.0000000000
      1.8415872271     1.0632408031     3.0072988447

ATOMIC_POSITIONS crystal
  Mg      0.00000000    -0.00000000     0.00000000
  S       0.50000000     0.50000000     0.50000000

K_POINTS automatic
  17 17 17  0 0 0
! Source: data/cifs/mp-1315.cif (mp-1315)
! binary ionic control
! PBE ONCV scalar-relativistic pseudopotentials
! Pre-production settings: converge cutoffs and k mesh before comparing functionals.
