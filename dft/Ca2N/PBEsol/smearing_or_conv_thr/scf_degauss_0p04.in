! SCF parameter sweep: smearing = 0.04
! Same structure, functional, pseudopotential, and magnetic seed as the parent vc-relax input.
&CONTROL
  calculation = 'scf',
  prefix = 'eld-0049_pbesol_degauss_0p04',
  outdir = './out_degauss_0p04',
  pseudo_dir = '../../../pseudo/PBEsol',
  tstress = .true.,
  tprnfor = .true.,
  disk_io = 'low',
/
&SYSTEM
  ibrav = 0,
  nat = 3,
  ntyp = 2,
  ecutwfc = 100,
  ecutrho = 400,
  input_dft = 'pbesol',
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.04,
/
&ELECTRONS
  conv_thr = 1.0d-9,
  mixing_mode = 'local-TF',
  mixing_beta = 0.40,
  electron_maxstep = 200,
  diagonalization = 'david',
/

ATOMIC_SPECIES
  Ca   40.078000 Ca.upf
  N    14.007000 N.upf

CELL_PARAMETERS angstrom
      6.7548549000     0.0000000000     0.0000000000
      5.7938761013     3.4726163102     0.0000000000
      5.7938768602     1.6033422366     3.0803178354

ATOMIC_POSITIONS crystal
  Ca      0.73140824     0.73140824     0.73140824
  Ca      0.26859176     0.26859176     0.26859176
  N      -0.00000000    -0.00000000     0.00000000

K_POINTS automatic
  14 14 14 0 0 0

