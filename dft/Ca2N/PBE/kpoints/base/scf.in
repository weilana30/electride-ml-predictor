! PBE SCF benchmark: kpoints =   17 17 17 0 0 0
! QE data are staged in scratch by the case submission script.
&CONTROL
  calculation = 'scf',
  prefix = 'eld-0049_pbe_kpoints_base',
  outdir = './qe_data',
  pseudo_dir = '../../../../pseudo/PBE_PAW',
  tstress = .true.,
  tprnfor = .true.,
  disk_io = 'low',
/
&SYSTEM
  ibrav = 0,
  nat = 3,
  ntyp = 2,
  
  
  input_dft = 'pbe',
  
  
  
  
  
  
  
  
  ecutwfc = 60,
  ecutrho = 480,
  occupations = 'smearing',
  smearing = 'methfessel-paxton',
  degauss = 0.02,
/
&ELECTRONS
  
  mixing_mode = 'local-TF',
  
  electron_maxstep = 200,
  diagonalization = 'david',
  
  
  conv_thr = 1.0d-8,
  mixing_beta = 0.7,
/

ATOMIC_SPECIES
  Ca   40.078000 Ca.pbe-spn-kjpaw_psl.1.0.0.UPF
  N    14.007000 N.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
      6.7548549000     0.0000000000     0.0000000000
      5.7938761013     3.4726163102     0.0000000000
      5.7938768602     1.6033422366     3.0803178354

ATOMIC_POSITIONS crystal
  Ca      0.73140824     0.73140824     0.73140824
  Ca      0.26859176     0.26859176     0.26859176
  N      -0.00000000    -0.00000000     0.00000000

K_POINTS automatic
  17 17 17 0 0 0
