&GLOBAL
  PROJECT BaSn3_cutoff_300
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UCL
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
      NGRIDS 5
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 200
      &DIAGONALIZATION ON
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBROYDEN 8
      &END MIXING
    &END SCF
    &KPOINTS
      SCHEME MONKHORST-PACK 5 5 5
    &END KPOINTS
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &PRINT
      &ELF_CUBE
        STRIDE 1 1 1
      &END ELF_CUBE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A  7.347868960000  0.000000000000  0.000000000000
      B -3.673994796500  6.363505421000  0.000000000000
      C  0.000010248400 -0.000017049300  5.649844710000
      PERIODIC XYZ
    &END CELL
    &COORD
      Ba -0.000041322855  4.242334806177  1.412461177500
      Ba  3.673925734755  2.121153565523  4.237383532500
      Sn  1.505488172780  0.869197506548  1.412461177500
      Sn -0.000012501896  1.738397177912  4.237383532500
      Sn -2.168481421542  5.494284501646  4.237383532500
      Sn  5.842365833442  0.869203870054  1.412461177500
      Sn  3.673896913796  4.625091193788  1.412461177500
      Sn  2.168396239120  5.494290865152  4.237383532500
    &END COORD
      &KIND Ba
        BASIS_SET DZVP-MOLOPT-SR-GTH-q10
        POTENTIAL GTH-PBE-q10
      &END KIND
      &KIND Sn
        BASIS_SET DZVP-MOLOPT-SR-GTH-q4
        POTENTIAL GTH-PBE-q4
      &END KIND
  &END SUBSYS
&END FORCE_EVAL
