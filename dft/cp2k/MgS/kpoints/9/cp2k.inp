&GLOBAL
  PROJECT MgS_kpoints_9
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UCL
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 60
      NGRIDS 5
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 200
      &DIAGONALIZATION ON
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBROYDEN 8
      &END MIXING
    &END SCF
    &KPOINTS
      SCHEME MONKHORST-PACK 9 9 9
    &END KPOINTS
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &PRINT
      &ELF_CUBE
        STRIDE 1 1 1
      &END ELF_CUBE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A  3.683174610000  0.000000000000  0.000000000000
      B  1.841587446300  3.189722766500  0.000000000000
      C  1.841587227100  1.063240803100  3.007298844700
      PERIODIC XYZ
    &END CELL
    &COORD
      Mg  0.000000000000  0.000000000000  0.000000000000
      S   3.683174641700  2.126481784800  1.503649422350
    &END COORD
      &KIND Mg
        BASIS_SET DZVP-MOLOPT-SR-GTH-q10
        POTENTIAL GTH-PBE-q10
      &END KIND
      &KIND S
        BASIS_SET DZVP-MOLOPT-SR-GTH-q6
        POTENTIAL GTH-PBE-q6
      &END KIND
  &END SUBSYS
&END FORCE_EVAL
