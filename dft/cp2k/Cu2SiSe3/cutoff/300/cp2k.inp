&GLOBAL
  PROJECT Cu2SiSe3_cutoff_300
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UCL
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
      NGRIDS 5
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 200
      &DIAGONALIZATION ON
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBROYDEN 8
      &END MIXING
    &END SCF
    &KPOINTS
      SCHEME MONKHORST-PACK 5 5 5
    &END KPOINTS
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &PRINT
      &ELF_CUBE
        STRIDE 1 1 1
      &END ELF_CUBE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A  6.685599120000  0.000000000000  0.000000000000
      B  2.113093474900  6.327461278600  0.000000000000
      C  1.056547311700  3.163730280500  5.861840070600
      PERIODIC XYZ
    &END CELL
    &COORD
      Cu  4.391513821747  3.087756660518  2.987233150161
      Cu  2.105260967033  6.251487243437  2.874606920439
      Cu  5.450787850523  6.309014502726  4.841918293368
      Cu  1.051443312878  3.145290488104  1.019921777232
      Si  5.556409065176  6.141535285316  0.994900102562
      Si  1.157065260140  2.977810736472  4.866939968038
      Se  3.173355722563  7.048456052738  4.868342999459
      Se  5.459608144386  3.884725587340  0.993497071141
      Se  6.534602190078  7.017593067246  2.836357651939
      Se  2.135255911155  3.853862416370  3.025482418661
      Se  1.199788495244  0.690885791271  0.920795013481
      Se  5.599137278496  3.854622448680  4.941045057119
    &END COORD
      &KIND Cu
        BASIS_SET DZVP-MOLOPT-SR-GTH-q11
        POTENTIAL GTH-PBE-q11
      &END KIND
      &KIND Se
        BASIS_SET DZVP-MOLOPT-SR-GTH-q6
        POTENTIAL GTH-PBE-q6
      &END KIND
      &KIND Si
        BASIS_SET DZVP-MOLOPT-SR-GTH-q4
        POTENTIAL GTH-PBE-q4
      &END KIND
  &END SUBSYS
&END FORCE_EVAL
