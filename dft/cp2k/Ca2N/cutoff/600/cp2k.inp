&GLOBAL
  PROJECT Ca2N_cutoff_600
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UCL
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 70
      NGRIDS 5
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 200
      &DIAGONALIZATION ON
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBROYDEN 8
      &END MIXING
    &END SCF
    &KPOINTS
      SCHEME MONKHORST-PACK 5 5 5
    &END KPOINTS
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &PRINT
      &ELF_CUBE
        STRIDE 1 1 1
      &END ELF_CUBE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A  6.754854900000  0.000000000000  0.000000000000
      B  5.793876101300  3.472616310200  0.000000000000
      C  5.793876860200  1.603342236600  3.080317835400
      PERIODIC XYZ
    &END CELL
    &COORD
      Ca  13.415934532990  3.712597907028  2.252969846631
      Ca  4.926673328510  1.363360639772  0.827347988769
      N   0.000000000000  0.000000000000  0.000000000000
    &END COORD
      &KIND Ca
        BASIS_SET DZVP-MOLOPT-SR-GTH-q10
        POTENTIAL GTH-PBE-q10
      &END KIND
      &KIND N
        BASIS_SET DZVP-MOLOPT-SR-GTH-q5
        POTENTIAL GTH-PBE-q5
      &END KIND
  &END SUBSYS
&END FORCE_EVAL
