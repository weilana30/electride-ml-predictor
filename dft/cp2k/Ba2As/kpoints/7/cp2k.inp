&GLOBAL
  PROJECT Ba2As_kpoints_7
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UCL
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 60
      NGRIDS 5
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 200
      &DIAGONALIZATION ON
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBROYDEN 8
      &END MIXING
    &END SCF
    &KPOINTS
      SCHEME MONKHORST-PACK 7 7 7
    &END KPOINTS
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC XYZ
    &END POISSON
    &PRINT
      &ELF_CUBE
        STRIDE 1 1 1
      &END ELF_CUBE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A  9.724302650000  0.000000000000  0.000000000000
      B  7.042173345200  6.705956800100  0.000000000000
      C -8.383237998000 -3.352978400200  3.611221198700
      PERIODIC XYZ
    &END CELL
    &COORD
      Ba  5.297066294116  2.118626343769  0.000000000000
      Ba  11.469409701084  4.587330456331  0.000000000000
      Ba -0.670532326400  1.676489199950  1.805610599350
      Ba  0.670532326000 -1.676489200100  1.805610599350
      As  2.217349683889  0.886856080856  0.000000000000
      As  14.549126311311  5.819100719244  0.000000000000
    &END COORD
      &KIND As
        BASIS_SET DZVP-MOLOPT-SR-GTH-q5
        POTENTIAL GTH-PBE-q5
      &END KIND
      &KIND Ba
        BASIS_SET DZVP-MOLOPT-SR-GTH-q10
        POTENTIAL GTH-PBE-q10
      &END KIND
  &END SUBSYS
&END FORCE_EVAL
