! SCF parameter sweep: ecutwfc = 120:480
! Same structure, functional, pseudopotential, and magnetic seed as the parent vc-relax input.
&CONTROL
  calculation = 'scf',
  prefix = 'eld-0003_pbe_ecutwfc_high',
  outdir = './out_ecutwfc_high',
  pseudo_dir = '../../../pseudo/PBE',
  tstress = .true.,
  tprnfor = .true.,
  disk_io = 'low',
/
&SYSTEM
  ibrav = 0,
  nat = 6,
  ntyp = 2,
  ecutwfc = 120,
  ecutrho = 480,
  input_dft = 'pbe',
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.02,
/
&ELECTRONS
  conv_thr = 1.0d-9,
  mixing_mode = 'local-TF',
  mixing_beta = 0.40,
  electron_maxstep = 200,
  diagonalization = 'david',
/

ATOMIC_SPECIES
  Ba  137.327000 Ba.upf
  As   74.921595 As.upf

CELL_PARAMETERS angstrom
      9.7243026500     0.0000000000     0.0000000000
      7.0421733452     6.7059568001     0.0000000000
     -8.3832379980    -3.3529784002     3.6112211987

ATOMIC_POSITIONS crystal
  Ba      0.31593200     0.31593200     0.00000000
  Ba      0.68406800     0.68406800     0.00000000
  Ba      0.00000000     0.50000000     0.50000000
  Ba      0.50000000     0.00000000     0.50000000
  As      0.13224900     0.13224900     0.00000000
  As      0.86775100     0.86775100     0.00000000

K_POINTS automatic
  9 9 12 0 0 0

