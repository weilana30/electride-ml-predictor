! SCF parameter sweep: ecutwfc = 80:320
! Same structure, functional, pseudopotential, and magnetic seed as the parent vc-relax input.
&CONTROL
  calculation = 'scf',
  prefix = 'eld-0014_pbe_ecutwfc_low',
  outdir = './out_ecutwfc_low',
  pseudo_dir = '../../../pseudo/PBE',
  tstress = .true.,
  tprnfor = .true.,
  disk_io = 'low',
/
&SYSTEM
  ibrav = 0,
  nat = 14,
  ntyp = 4,
  ecutwfc = 80,
  ecutrho = 320,
  input_dft = 'pbe',
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.02,
  nspin = 2,
  starting_magnetization(2) = 0.60,
  starting_magnetization(3) = -0.60,
  nosym = .true.,
/
&ELECTRONS
  conv_thr = 1.0d-9,
  mixing_mode = 'local-TF',
  mixing_beta = 0.40,
  electron_maxstep = 200,
  diagonalization = 'david',
/

ATOMIC_SPECIES
  Ba  137.327000 Ba.upf
  Cr1  51.996100 Cr.upf
  Cr2  51.996100 Cr.upf
  N    14.007000 N.upf

