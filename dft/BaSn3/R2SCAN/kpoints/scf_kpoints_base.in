! SCF parameter sweep: kpoints =   17 17 17 0 0 0
! Same structure, functional, pseudopotential, and magnetic seed as the parent vc-relax input.
&CONTROL
  calculation = 'scf',
  prefix = 'mp-7759_r2scan_kpoints_base',
  outdir = './out_kpoints_base',
  pseudo_dir = '../../../pseudo/PBE_PAW',
  tstress = .true.,
  tprnfor = .true.,
  disk_io = 'low',
/
&SYSTEM
  ibrav = 0,
  nat = 8,
  ntyp = 2,
  
  
  input_dft = 'r2scan',
  
  
  
  
  
  
  
  
  ecutwfc = 60,
  ecutrho = 480,
  occupations = 'smearing',
  smearing = 'methfessel-paxton',
  degauss = 0.02,
/
&ELECTRONS
  
  mixing_mode = 'local-TF',
  
  electron_maxstep = 200,
  diagonalization = 'david',
  
  
  conv_thr = 1.0d-8,
  mixing_beta = 0.7,
/

ATOMIC_SPECIES
  Ba  137.327000 Ba.pbe-spn-kjpaw_psl.1.0.0.UPF
  Sn  118.710000 Sn.pbe-dn-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
      7.3478689600     0.0000000000     0.0000000000
     -3.6739947965     6.3635054210     0.0000000000
      0.0000102484    -0.0000170493     5.6498447100

ATOMIC_POSITIONS crystal
  Ba      0.33333300     0.66666700     0.25000000
  Ba      0.66666700     0.33333300     0.75000000
  Sn      0.27318433     0.13659166     0.25000000
  Sn      0.13659166     0.27318433     0.75000000
  Sn      0.13659266     0.86340734     0.75000000
  Sn      0.86340734     0.13659266     0.25000000
  Sn      0.86340834     0.72681567     0.25000000
  Sn      0.72681567     0.86340834     0.75000000

K_POINTS automatic
  17 17 17 0 0 0
